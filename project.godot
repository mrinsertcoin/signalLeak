; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]
config/name="Signal Leak"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]
move_left={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":65},{"type":"InputEventKey","physical_keycode":4194319}]}
move_right={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":68},{"type":"InputEventKey","physical_keycode":4194321}]}
move_up={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":87},{"type":"InputEventKey","physical_keycode":4194320}]}
move_down={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":83},{"type":"InputEventKey","physical_keycode":4194322}]}
shoot={"deadzone":0.5,"events":[{"type":"InputEventMouseButton","button_index":1}]}
pause={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":4194305}]}
restart={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":82}]}
toggle_autoshoot={"deadzone":0.5,"events":[{"type":"InputEventMouseButton","button_index":2}]}
start_endless={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":49}]}
start_campaign={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":50}]}
start_debug={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":51}]}
ultra_attack={"deadzone":0.5,"events":[{"type":"InputEventKey","physical_keycode":81}]}

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
